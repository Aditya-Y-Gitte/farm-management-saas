{
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "farm-management-auth",
    "Audience": "farm-management-api"
  },
  // Set FrontendUrl in production via environment variable: FrontendUrl=https://your-app.netlify.app
  "FrontendUrl": "",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "ServiceUrls": {
    "CatalogApi": "http://localhost:5001",
    "ProductionApi": "http://localhost:5002"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "production-route": {
        "ClusterId": "production-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/production/{**catch-all}"
        }
      },
      "finance-route": {
        "ClusterId": "finance-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "production-cluster": {
        "Destinations": {
          "production-api": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "finance-api": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  }
}